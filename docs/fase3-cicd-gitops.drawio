        </mxCell>
        <mxCell id="tf_wf" value="&lt;b&gt;terraform.yml&lt;/b&gt; (paths: terraform/**)&lt;br&gt;PR: fmt · validate · tflint · checkov · plan&lt;br&gt;release/* → develop · tag rc → staging · tag → prod" style="rounded=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7B42BC;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;spacingLeft=8;" vertex="1" parent="tf_g">
