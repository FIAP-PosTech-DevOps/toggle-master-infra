        <mxCell id="svc_note" value="cada repo tem &lt;i&gt;ci.yml&lt;/i&gt;, &lt;i&gt;release.yml&lt;/i&gt; e &lt;i&gt;promote.yml&lt;/i&gt;&lt;br&gt;curtos, que chamam os reutilizáveis" style="text;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=center;" vertex="1" parent="svc_g">
          <mxGeometry x="10" y="290" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ci_g" value="GitHub Actions — CI de cada serviço (independente) · workflow reutilizável service-ci.yml" style="rounded=1;arcSize=3;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;collapsible=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="460" y="96" width="900" height="340" as="geometry" />
        </mxCell>
        <mxCell id="st1" value="&lt;b&gt;1. Build &amp;amp; Unit Test&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;go build · go test&lt;br&gt;pytest&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="ci_g">
          <mxGeometry x="18" y="50" width="128" height="100" as="geometry" />
        </mxCell>
        <mxCell id="st2" value="&lt;b&gt;2. Lint&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;golangci-lint&lt;br&gt;flake8&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="ci_g">
          <mxGeometry x="164" y="50" width="128" height="100" as="geometry" />
        </mxCell>
        <mxCell id="st3" value="&lt;b&gt;3. SAST + SCA&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;SonarQube Cloud&lt;br&gt;Snyk (ou Trivy fs)&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#B91C1C;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="ci_g">
          <mxGeometry x="310" y="50" width="128" height="100" as="geometry" />
        </mxCell>
        <mxCell id="st4" value="&lt;b&gt;4. Docker Build&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;+ Trivy image&lt;br&gt;(container scan)&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FEE2E2;strokeColor=#B91C1C;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="ci_g">
          <mxGeometry x="456" y="50" width="128" height="100" as="geometry" />
        </mxCell>
        <mxCell id="st5" value="&lt;b&gt;5. Push ECR&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;login OIDC&lt;br&gt;tag vX.Y.Z-&amp;lt;sha&amp;gt;&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="ci_g">
          <mxGeometry x="602" y="50" width="128" height="100" as="geometry" />
        </mxCell>
        <mxCell id="st6" value="&lt;b&gt;6. Atualiza tag&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;commit no repo&lt;br&gt;GitOps&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="ci_g">
          <mxGeometry x="748" y="50" width="128" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;CRÍTICA?&lt;/b&gt;" style="rhombus;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="ci_g">
          <mxGeometry x="315" y="182" width="120" height="72" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="&lt;b&gt;Pipeline falha&lt;/b&gt;&lt;br&gt;sem push · sem deploy" style="rounded=1;arcSize=8;fillColor=#B91C1C;strokeColor=#7F1D1D;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="ci_g">
          <mxGeometry x="100" y="188" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ci_note" value="Gatilho: PR para &lt;i&gt;release/*&lt;/i&gt; roda até o passo 4 (sem push/deploy); push em &lt;i&gt;release/vX.Y.Z&lt;/i&gt; roda tudo e sobe em develop. Tags &lt;i&gt;-rc.N&lt;/i&gt;/final só promovem a mesma imagem (com re-scan do Trivy). Cada serviço dispara só a própria pipeline. Depois do push, o Snyk monitor acompanha CVEs novas." style="text;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="ci_g">
          <mxGeometry x="20" y="272" width="600" height="58" as="geometry" />
        </mxCell>
        <mxCell id="go_g" value="toggle-master-gitops (GitHub) — estado desejado do cluster" style="rounded=1;arcSize=3;fillColor=#ECFDF5;strokeColor=#047857;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;collapsible=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1410" y="96" width="450" height="340" as="geometry" />
        </mxCell>
        <mxCell id="go_tree" value="&lt;font face='Courier New'&gt;apps/&amp;lt;serviço&amp;gt;/&lt;br&gt;&amp;nbsp;&amp;nbsp;base/ &amp;nbsp;deployment · service · ingress&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;externalsecret · migração · hpa|keda&lt;br&gt;&amp;nbsp;&amp;nbsp;overlays/develop|staging|production/&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;kustomization.yaml &amp;nbsp;(newTag)&lt;br&gt;platform/ &amp;nbsp;ClusterSecretStore (ESO→OpenBao)&lt;br&gt;clusters/&amp;lt;ambiente&amp;gt;/&lt;br&gt;&amp;nbsp;&amp;nbsp;AppProject · platform · ApplicationSet&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#047857;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="go_g">
          <mxGeometry x="18" y="40" width="414" height="190" as="geometry" />
        </mxCell>
        <mxCell id="go_note" value="Kustomize para as apps próprias · ferramentas de terceiros por Helm, no Terraform (cluster-addons).&lt;br&gt;A CI altera só &lt;i&gt;images[].newTag&lt;/i&gt; do serviço e ambiente." style="text;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="go_g">
          <mxGeometry x="18" y="240" width="414" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tf_g" value="toggle-master-infra (GitHub)" style="rounded=1;arcSize=3;fillColor=#F5F3FF;strokeColor=#7B42BC;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;container=1;collapsible=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="486" width="370" height="350" as="geometry" />
        </mxCell>
        <mxCell id="tf_mod" value="&lt;b&gt;terraform/modules&lt;/b&gt; · network · eks · data&lt;br&gt;messaging · workload-identity (IRSA)" style="rounded=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7B42BC;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;spacingLeft=8;" vertex="1" parent="tf_g">
          <mxGeometry x="16" y="40" width="338" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tf_env" value="&lt;b&gt;bootstrap&lt;/b&gt; · &lt;b&gt;global&lt;/b&gt; (1x por conta: state, ECR, OIDC)&lt;br&gt;&lt;b&gt;infra/envs/*.tfvars&lt;/b&gt;: uma região por ambiente" style="rounded=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7B42BC;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;spacingLeft=8;" vertex="1" parent="tf_g">
