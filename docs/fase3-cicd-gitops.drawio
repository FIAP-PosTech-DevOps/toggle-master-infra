        <mxCell id="tf_reuse" value="&lt;b&gt;.github/workflows&lt;/b&gt; (reutilizáveis) · service-ci.yml&lt;br&gt;service-promote.yml · git-release.yml" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;align=left;spacingLeft=8;" vertex="1" parent="tf_g">
