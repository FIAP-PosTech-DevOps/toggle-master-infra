<diagram id="seg" name="2. Segurança e IRSA">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="seg_t1" value="Segurança — privilégio mínimo por workload" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="seg_t2" value="Cada pod assume a própria role via OIDC. Nenhuma credencial estática em manifesto." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nodeg" value="Role dos nós EKS — togglemaster-lab-eks-node-role" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=#B85450;fillColor=#F8CECC;verticalAlign=top;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="np1" value="AmazonEKSWorkerNodePolicy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B85450;fillColor=#F8CECC;verticalAlign=middle;arcSize=12;" vertex="1" parent="nodeg">
          <mxGeometry x="20" y="40" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="np2" value="AmazonEKS_CNI_Policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B85450;fillColor=#F8CECC;verticalAlign=middle;arcSize=12;" vertex="1" parent="nodeg">
          <mxGeometry x="20" y="78" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="np3" value="ECR read-only + pull-through (escopado a k8s/* e ecr-public/*)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B85450;fillColor=#F8CECC;verticalAlign=middle;arcSize=12;" vertex="1" parent="nodeg">
          <mxGeometry x="20" y="116" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="npn" value="Sem SQS, sem DynamoDB, sem ELB. O nó não empresta permissão a pod nenhum." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="nodeg">
          <mxGeometry x="20" y="152" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="oidc" value="Provedor OIDC do cluster" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1">
          <mxGeometry x="620" y="195" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="oidcl" value="sts:AssumeRoleWithWebIdentity" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="560" y="265" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="irsa" value="Roles IRSA — uma por workload" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=top;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="700" height="400" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="&lt;b&gt;evaluation-service-sa&lt;/b&gt;&lt;br&gt;sqs:SendMessage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=middle;arcSize=12;" vertex="1" parent="irsa">
          <mxGeometry x="20" y="40" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="&lt;b&gt;analytics-service-sa&lt;/b&gt;&lt;br&gt;sqs:Receive/Delete/GetQueueAttributes&lt;br&gt;dynamodb:PutItem" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=middle;arcSize=12;" vertex="1" parent="irsa">
          <mxGeometry x="360" y="40" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="&lt;b&gt;kube-system:aws-load-balancer-controller&lt;/b&gt;&lt;br&gt;gerencia Load Balancers" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=middle;arcSize=12;" vertex="1" parent="irsa">
          <mxGeometry x="20" y="130" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="&lt;b&gt;keda:keda-operator&lt;/b&gt;&lt;br&gt;sqs:GetQueueAttributes / GetQueueUrl" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=middle;arcSize=12;" vertex="1" parent="irsa">
          <mxGeometry x="360" y="130" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="i5" value="&lt;b&gt;Quem chama o SQS pelo KEDA é o operador&lt;/b&gt;, no namespace keda — não a Service Account do analytics-service. A trust policy aponta para keda:keda-operator, e o chart anota essa SA." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="irsa">
          <mxGeometry x="20" y="210" width="660" height="65" as="geometry" />
        </mxCell>
        <mxCell id="i6" value="&lt;b&gt;Prova de privilégio mínimo&lt;/b&gt;&lt;br&gt;analytics-service-sa consegue dynamodb:PutItem, mas recebe AccessDenied em dynamodb:Scan — verificável com dois pods de teste." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="irsa">
          <mxGeometry x="20" y="290" width="660" height="70" as="geometry" />
        </mxCell>
        <mxCell id="net" value="Isolamento de rede" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=top;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="700" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Nós, RDS e ElastiCache em sub-rede privada — sem IP público" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;" vertex="1" parent="net">
          <mxGeometry x="20" y="40" width="660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="SG do RDS libera 5432 apenas a partir do SG dos nós" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;" vertex="1" parent="net">
          <mxGeometry x="20" y="78" width="660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="SG do Redis libera 6379 apenas a partir do SG dos nós" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;" vertex="1" parent="net">
          <mxGeometry x="20" y="116" width="660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Endpoint do cluster restrito por CIDR (IP do operador)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;" vertex="1" parent="net">
          <mxGeometry x="20" y="154" width="660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="IMDSv2 obrigatório nos nós, hop limit 1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;" vertex="1" parent="net">
          <mxGeometry x="20" y="192" width="660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cred" value="Credenciais" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=#D6B656;fillColor=#FFF2CC;verticalAlign=top;align=top;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="540" width="700" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Senha do RDS&lt;/b&gt; — gerada pelo próprio RDS, guardada no Secrets Manager.&lt;br&gt;Nunca passa por código, tfvars ou state." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#D6B656;fillColor=#FFF2CC;verticalAlign=middle;arcSize=12;" vertex="1" parent="cred">
          <mxGeometry x="20" y="40" width="660" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;MASTER_KEY&lt;/b&gt; — gerada no deploy, vive só em Secret do Kubernetes." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#D6B656;fillColor=#FFF2CC;verticalAlign=middle;arcSize=12;" vertex="1" parent="cred">
          <mxGeometry x="20" y="95" width="660" height="35" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;SERVICE_API_KEY&lt;/b&gt; — criada em runtime via POST /admin/keys.&lt;br&gt;O banco guarda apenas o hash SHA-256." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#D6B656;fillColor=#FFF2CC;verticalAlign=middle;arcSize=12;" vertex="1" parent="cred">
          <mxGeometry x="20" y="140" width="660" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Criptografia em repouso: RDS, ElastiCache, ECR e Secrets do etcd, com CMK própria." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="cred">
