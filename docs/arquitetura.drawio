        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="flx_t1" value="Fluxo de uma sessão — do zero ao ambiente no ar" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="flx_t2" value="~45 minutos, a maior parte esperando a AWS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="700" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1. terraform apply módulo infra" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1d" value="~20 min" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="275" y="150" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s1x" value="VPC, EKS, node group, 3 RDS, ElastiCache, DynamoDB, SQS + DLQ, ECR, IRSA, KMS, budget" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. aws eks update-kubeconfig" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2d" value="~5 s" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="275" y="250" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s2x" value="Obrigatório a cada ciclo: o endpoint e o certificado do cluster mudam" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="230" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flxe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#4D5B6B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. ./mirror-images.sh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3d" value="~5 min" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="275" y="350" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s3x" value="Espelha para o ECR as imagens do KEDA (ghcr.io) e as bases dos Dockerfiles (Docker Hub)" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flxe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#4D5B6B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. terraform apply cluster-addons" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4d" value="~5 min" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="275" y="450" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s4x" value="metrics-server, ALB controller, ingress-nginx, KEDA, namespace e Service Accounts" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="430" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flxe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#4D5B6B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. ./build-and-push.sh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5d" value="~6 min" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="275" y="550" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s5x" value="Build multi-stage das 5 imagens e push ao ECR. Aceita lista para construir só o que mudou" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="530" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flxe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#4D5B6B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. ./deploy.sh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#6C8EBF;fillColor=#DAE8FC;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="630" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6d" value="~4 min" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6C7D;" vertex="1" parent="1">
          <mxGeometry x="275" y="650" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s6x" value="Schemas, ConfigMap, Secrets, os 5 serviços, Ingress, HPA e ScaledObject" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="360" y="630" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flxe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#4D5B6B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="phase" value="Deploy em duas fases — por que o auth-service vem primeiro" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=#D6B656;fillColor=#FFF2CC;verticalAlign=top;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="620" height="300" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="A tabela api_keys nasce vazia — o init.sql cria a estrutura, sem inserir chave." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#D6B656;fillColor=#FFF2CC;verticalAlign=middle;arcSize=12;" vertex="1" parent="phase">
          <mxGeometry x="20" y="40" width="580" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="O evaluation-service precisa de uma SERVICE_API_KEY válida para chamar flag e targeting." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#D6B656;fillColor=#FFF2CC;verticalAlign=middle;arcSize=12;" vertex="1" parent="phase">
          <mxGeometry x="20" y="88" width="580" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Essas chamadas são validadas contra o auth-service, que compara o hash SHA-256." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#D6B656;fillColor=#FFF2CC;verticalAlign=middle;arcSize=12;" vertex="1" parent="phase">
          <mxGeometry x="20" y="136" width="580" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="Logo: sobe o auth-service → POST /admin/keys → grava no Secret → sobe o resto." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=middle;arcSize=12;" vertex="1" parent="phase">
          <mxGeometry x="20" y="184" width="580" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="Subir tudo de uma vez resultaria em 401 em toda avaliação." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="phase">
          <mxGeometry x="20" y="234" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="part" value="Deploy parcial — cenário do dia a dia" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=top;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="460" width="620" height="190" as="geometry" />
        </mxCell>
        <mxCell id="pa1" value="./build-and-push.sh v2 flag-service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=middle;arcSize=12;" vertex="1" parent="part">
          <mxGeometry x="20" y="40" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pa2" value="./deploy-service.sh flag-service v2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#82B366;fillColor=#D5E8D4;verticalAlign=middle;arcSize=12;" vertex="1" parent="part">
          <mxGeometry x="20" y="78" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pa3" value="Não toca nos outros serviços, no Ingress nem no ConfigMap. Confere a imagem no ECR antes de aplicar." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="part">
          <mxGeometry x="20" y="116" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dest" value="Destruição — a ordem importa" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeColor=#B85450;fillColor=#F8CECC;verticalAlign=top;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="680" width="620" height="230" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="1. ./destroy.sh — remove ScaledObject e TriggerAuthentication com o operador do KEDA ainda vivo" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B85450;fillColor=#F8CECC;verticalAlign=middle;arcSize=12;" vertex="1" parent="dest">
          <mxGeometry x="20" y="40" width="580" height="45" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="2. terraform destroy — cluster-addons (libera o NLB)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B85450;fillColor=#F8CECC;verticalAlign=middle;arcSize=12;" vertex="1" parent="dest">
          <mxGeometry x="20" y="93" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="3. terraform destroy — infra" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B85450;fillColor=#F8CECC;verticalAlign=middle;arcSize=12;" vertex="1" parent="dest">
          <mxGeometry x="20" y="131" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Invertendo 1 e 2, os finalizers do KEDA travam a exclusão. Invertendo 2 e 3, o NLB fica órfão cobrando e a VPC não sai." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=10;strokeColor=#666666;fillColor=#FFFFFF;spacingLeft=4;" vertex="1" parent="dest">
          <mxGeometry x="20" y="169" width="580" height="50" as="geometry" />
        </mxCell>
      </root>
