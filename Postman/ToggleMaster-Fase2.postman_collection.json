{
  "info": {
    "name": "ToggleMaster - Fase 2 (local)",
    "description": "Coleção para testar os 5 microsserviços do ToggleMaster rodando via Docker Compose.\n\nOrdem sugerida: execute a pasta '1. Setup' primeiro (cria a chave de API e salva na variável api_key automaticamente), depois as demais.\n\nRotas confirmadas a partir do código-fonte dos serviços.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "07af24cb-4de0-4025-b74d-42b54dbf2a71"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:8001"
    },
    {
      "key": "flag_url",
      "value": "http://localhost:8002"
    },
    {
      "key": "targeting_url",
      "value": "http://localhost:8003"
    },
    {
      "key": "evaluation_url",
      "value": "http://localhost:8004"
    },
    {
      "key": "analytics_url",
      "value": "http://localhost:8005"
    },
    {
      "key": "master_key",
      "value": "admin-secreto-123"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "flag_name",
      "value": "novo-simulador"
    },
    {
      "key": "user_id",
      "value": "user-12345"
    }
  ],
  "item": [
    {
      "name": "0. Health checks",
      "item": [
        {
