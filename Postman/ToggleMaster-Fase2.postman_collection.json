              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifica se o flag-service está no ar."
          },
          "response": []
        },
        {
          "name": "targeting-service /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{targeting_url}}/health",
              "host": [
                "{{targeting_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifica se o targeting-service está no ar."
          },
          "response": []
        },
        {
          "name": "evaluation-service /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{evaluation_url}}/health",
              "host": [
                "{{evaluation_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Verifica se o evaluation-service está no ar."
          },
          "response": []
